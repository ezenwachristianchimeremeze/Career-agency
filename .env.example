# Copy these values into your shell environment for local development.
# Generate a strong random secret and keep it private; never commit a real value.
CAREER_AGENCY_SECRET_KEY=replace-with-a-long-random-secret
CAREER_AGENCY_CORE_DB=career_agency_core.db
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
CAREER_AGENCY_COOKIE_SECURE=0
CAREER_AGENCY_ENABLE_LEGACY_ROUTES=0

# Required only when enabling Paystack checkout.
PAYSTACK_SECRET_KEY=

# Optional provider adapter. The endpoint must accept {action, model, input}
# and return a JSON object. Keep the key on the server only.
CAREER_AGENCY_LLM_ENDPOINT=
CAREER_AGENCY_LLM_API_KEY=

# Public origin used to construct one-time verification and reset links.
CAREER_AGENCY_PUBLIC_URL=http://127.0.0.1:5000

# Required for account verification and password-reset email delivery.
CAREER_AGENCY_AUTH_EMAIL_ENDPOINT=
CAREER_AGENCY_AUTH_EMAIL_API_KEY=
